; Engine configuration file.
; It's best edited using the editor GUI and not directly,
; but this is the canonical way it exists on disk.

config_version=5

[application]

config/name="The Frontier"
config/version="0.1.0"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon/icon.svg"
run/main_scene="res://scenes/main/Main.tscn"

[autoload]

GameData="*res://scripts/autoloads/GameData.gd"
GameState="*res://scripts/autoloads/GameState.gd"
WorldManager="*res://scripts/autoloads/WorldManager.gd"
SettlementManager="*res://scripts/autoloads/SettlementManager.gd"
EconomyManager="*res://scripts/autoloads/EconomyManager.gd"
DisciplineManager="*res://scripts/autoloads/DisciplineManager.gd"
BatchProcessor="*res://scripts/autoloads/BatchProcessor.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"

